# Copy to .env in the directory from which you launch xsh.
# Use your provider's API base URL, NOT the full /chat/completions endpoint.
XSH_BASE_URL=https://api.deepseek.com
XSH_MODEL=deepseek-flash
XSH_API_KEY=your-api-key

# DeepSeek Anthropic-compatible search API base URL; /messages is appended.
XSH_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
XSH_SEARCH_MODEL=deepseek-v4-flash
# Leave blank to reuse XSH_API_KEY (or OPENAI_API_KEY).
XSH_SEARCH_API_KEY=

# Optional runtime tuning (uncomment to override defaults).
# XSH_ALLOW_SHELL=1                 # Enable unsandboxed shell without passing --allow-shell.
# XSH_MAX_STEPS=100000
# XSH_MAX_TURNS=                   # Optional cap on non-stop continuation turns.
# XSH_MAX_RUN_TOKENS=              # Optional token budget for a non-stop run before stopping.
# XSH_SESSION_COMPACT_MB=0         # Offline-compact a session file on resume when larger than this many MB (0 disables).
# XSH_CONTEXT_WINDOW=819200        # Model context window in tokens (auto-discovery may override).
# XSH_AUTO_COMPACT=true            # Compact long context automatically before requests.
# XSH_COMPACT_THRESHOLD=0.8        # Compact when context pressure exceeds this fraction.
# XSH_COMPACT_RETAIN_RATIO=0.16    # Fraction of recent context to retain after compaction.
# XSH_REQUEST_TIMEOUT=600          # Per-request timeout in seconds.
# XSH_MAX_RETRIES=3                # SDK-level request retries.
